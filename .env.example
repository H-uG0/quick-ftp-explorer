# Copy to .env and adjust. Never commit .env.

# Public hostname. Point its DNS record at this server first: Caddy then
# obtains the HTTPS certificate automatically.
DOMAIN=files.example.com

# Prefilled in the "New shortcut" form.
DEFAULT_FTP_HOST=192.0.2.10
DEFAULT_FTP_PORT=21

# Recommended: the only FTP host(s) shortcuts may point at.
#FTP_ALLOWED_HOSTS=192.0.2.10

# Simultaneous FTP connections per server, all users together. Keep it at or
# below the FTP server's own per-IP limit.
#FTP_MAX_CONNECTIONS=10

# How long the FTP server may stay silent before a request fails (ms).
#FTP_TIMEOUT_MS=15000

# Session lifetime, in hours.
#SESSION_TTL_HOURS=12

# Leave unset: a random secret is generated once into the data volume.
# Changing it signs everybody out.
#SESSION_SECRET=
