<!DOCTYPE html>
<html>
<head>
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta charset="utf-8" />
  <title>Quick FTP Explorer - config tests</title>
  <HTA:APPLICATION
    APPLICATIONNAME="QuickFtpExplorerConfigTests"
    ID="QuickFtpExplorerConfigTests"
    BORDER="thin"
    SINGLEINSTANCE="yes"
    SCROLL="yes" />
  <link rel="stylesheet" href="../ui/styles.css" />
  <style>
    .test-main { padding: 16px; }
    .assertion { padding: 4px 8px; border-left: 3px solid #ccc; margin: 2px 0; font-family: Consolas, monospace; font-size: 12px; }
    .assertion.pass { border-left-color: #2e7d32; background: #e8f5e9; }
    .assertion.fail { border-left-color: #c62828; background: #ffebee; }
    .summary { margin-top: 10px; font-weight: 600; }
    button { margin-right: 8px; }
  </style>
</head>
<body>
  <div id="app">
    <header class="topbar">
      <div class="title">Quick FTP Explorer &mdash; config tests</div>
    </header>
    <main class="test-main">
      <div>
        <button id="btn-run" type="button">Run tests</button>
        <button id="btn-list" type="button">List shortcuts</button>
      </div>
      <div id="results"></div>
      <pre id="detail" class="output">(nothing yet)</pre>
    </main>
  </div>
  <script src="../ui/js/shell.js"></script>
  <script src="../ui/js/config.js"></script>
  <script>
  (function () {
    var results = document.getElementById("results");
    var detail = document.getElementById("detail");

    function log(msg, ok) {
      var el = document.createElement("div");
      el.className = "assertion " + (ok ? "pass" : "fail");
      el.innerText = (ok ? "PASS " : "FAIL ") + msg;
      results.appendChild(el);
      return ok;
    }
    function clear() { results.innerHTML = ""; detail.innerText = ""; }

    function deepEqual(a, b) {
      if (a === b) return true;
      if (typeof a !== typeof b) return false;
      if (typeof a !== "object" || a === null || b === null) return false;
      for (var k in a) if (a.hasOwnProperty(k) && a[k] !== b[k]) return false;
      for (var k2 in b) if (b.hasOwnProperty(k2) && a[k2] !== b[k2]) return false;
      return true;
    }

    function runTests() {
      clear();
      var passed = 0, failed = 0;
      function assert(name, cond) { (cond ? passed++ : failed++); log(name, !!cond); }

      // parseCsv basic
      var rows = QFE.config.parseCsv("a,b,c\n1,2,3\n");
      assert("parseCsv: 2 rows", rows.length === 2);
      assert("parseCsv: header intact", rows[0][0] === "a" && rows[0][2] === "c");
      assert("parseCsv: second row", rows[1][1] === "2");

      // parseCsv quoted field with comma
      var quoted = QFE.config.parseCsv('name,label\n1,"hello, world"\n');
      assert("parseCsv: quoted comma preserved", quoted[1][1] === "hello, world");

      // parseCsv with escaped quotes
      var esc = QFE.config.parseCsv('a\n"she said ""hi"""\n');
      assert('parseCsv: escaped "" -> "', esc[1][0] === 'she said "hi"');

      // sanitizeId
      assert("sanitizeId: alphanum passes", QFE.config.sanitizeId("abc_123") === "abc_123");
      assert("sanitizeId: slashes replaced", QFE.config.sanitizeId("a/b\\c") === "a_b_c");

      // readDefaults returns sane values
      var d = QFE.config.readDefaults();
      assert("readDefaults: default_host present", !!d.default_host);
      assert("readDefaults: default_port numeric", typeof d.default_port === "number" && d.default_port > 0);

      // CRUD round-trip using a throwaway username.
      var testUser = "__qfe_test__" + new Date().getTime();
      var sc = {
        label: testUser + " - sample (éàü)",
        host: "example.invalid",
        port: 2121,
        username: testUser,
        password: testUser
      };
      var id = QFE.config.saveShortcut(sc);
      assert("saveShortcut: returns id", id === testUser);

      var all = QFE.config.listShortcuts();
      var found = null;
      for (var i = 0; i < all.length; i++) if (all[i].id === testUser) { found = all[i]; break; }
      assert("listShortcuts: finds saved entry", !!found);
      if (found) {
        assert("listShortcuts: label round-trip (utf-8)", found.label === sc.label);
        assert("listShortcuts: port round-trip", found.port === sc.port);
        assert("listShortcuts: password round-trip", found.password === sc.password);
      }

      QFE.config.deleteShortcut(testUser);
      var afterDelete = QFE.config.listShortcuts();
      var stillThere = false;
      for (var j = 0; j < afterDelete.length; j++) if (afterDelete[j].id === testUser) stillThere = true;
      assert("deleteShortcut: entry removed", !stillThere);

      log("Total: " + passed + " passed, " + failed + " failed", failed === 0);
    }

    document.getElementById("btn-run").onclick = runTests;

    document.getElementById("btn-list").onclick = function () {
      var all = QFE.config.listShortcuts();
      var lines = [];
      for (var i = 0; i < all.length; i++) {
        lines.push(all[i].id + "\t" + all[i].host + ":" + all[i].port + "\t" + all[i].label);
      }
      detail.innerText = lines.length ? lines.join("\n") : "(no shortcuts yet)";
    };
  })();
  </script>
</body>
</html>
