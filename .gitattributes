# Auto detect text files and perform LF normalization
* text=auto

# cmd.exe batch files always check out with CRLF, whatever core.autocrlf says.
*.bat text eol=crlf

# Files used inside Linux containers always check out with LF.
Dockerfile text eol=lf
*.yml text eol=lf
deploy/** text eol=lf
.env.example text eol=lf
